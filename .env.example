# =============================================================================
# AssetFlow Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/assetflow?schema=public"

# ─── Auth / Security ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ─── Application ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── File Storage ─────────────────────────────────────────────────
UPLOAD_DIR="./public/uploads"
# For production, use S3/GCS:
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# ─── Logging ──────────────────────────────────────────────────────
# Options: debug, info, warn, error
LOG_LEVEL="debug"

# ─── Rate Limiting ────────────────────────────────────────────────
# Max requests per window (default: 100 general, 10 for auth)
RATE_LIMIT_GENERAL="100"
RATE_LIMIT_AUTH="10"
RATE_LIMIT_WINDOW_MS="60000"

# ─── Security ─────────────────────────────────────────────────────
# Max failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production only; dev allows localhost)
ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# ─── Email / SMTP (Notifications) ────────────────────────────────
# Required for email notifications. Leave blank to use in-app only.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="AssetFlow <noreply@yourdomain.com>"

# Notification channel: "in_app", "email", or "both" (default: both)
NOTIFICATION_CHANNEL="both"
